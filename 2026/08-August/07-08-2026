#include <iostream>
using namespace std;

int main() {
    int a[3][3];

    cout << "Enter 3x3 matrix:\n";

    for(int i = 0; i < 3; i++) {
        for(int j = 0; j < 3; j++) {
            cin >> a[i][j];
        }
    }

    cout << "Border element sum of each row:\n";

    for(int i = 0; i < 3; i++) {
        int sum = a[i][0] + a[i][2];
        cout << "Row " << i + 1 << " = " << sum << endl;
    }

    return 0;
}
