#include <iostream>
using namespace std;

int main() {
    int n;
    cin >> n;

    int largest = 0;

    for (int i = 0; i < n; i++) {
        int x;
        cin >> x;

        if (x > largest) {
            largest = x;
        }
    }

    cout << "Largest: " << largest << endl;

    return 0;
}
