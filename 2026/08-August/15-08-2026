#include <iostream>
using namespace std;

int main() {
    int arr[100], n;

    cout << "Enter number of elements: ";
    cin >> n;

    cout << "Enter elements:\n";
    for(int i = 0; i < n; i++)
        cin >> arr[i];

    cout << "Duplicate elements: ";

    for(int i = 0; i < n; i++) {
        bool duplicate = false;

        for(int j = i + 1; j < n; j++) {
            if(arr[i] == arr[j]) {
                duplicate = true;
                break;
            }
        }

        if(duplicate) {
            bool printed = false;

            for(int k = 0; k < i; k++) {
                if(arr[k] == arr[i]) {
                    printed = true;
                    break;
                }
            }

            if(!printed)
                cout << arr[i] << " ";
        }
    }

    return 0;
}
