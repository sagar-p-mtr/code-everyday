#include <iostream>
using namespace std;

int main() {
    int arr[100], n, majority = -1;

    cout << "Enter number of elements: ";
    cin >> n;

    cout << "Enter elements:\n";
    for(int i = 0; i < n; i++)
        cin >> arr[i];

    for(int i = 0; i < n; i++) {
        int count = 0;

        for(int j = 0; j < n; j++) {
            if(arr[i] == arr[j])
                count++;
        }

        if(count > n / 2) {
            majority = arr[i];
            break;
        }
    }

    if(majority != -1)
        cout << "Majority Element = " << majority;
    else
        cout << "No Majority Element";

    return 0;
}
