#include <iostream>
using namespace std;

int main() {
    int a[3][3];
    int primeCount = 0;

    cout << "Enter 3x3 matrix:\n";

    for(int i = 0; i < 3; i++) {
        for(int j = 0; j < 3; j++) {
            cin >> a[i][j];
        }
    }

    for(int i = 0; i < 3; i++) {
        for(int j = 0; j < 3; j++) {
            int num = a[i][j];
            bool prime = true;

            if(num <= 1)
                prime = false;

            for(int k = 2; k <= num / 2; k++) {
                if(num % k == 0) {
                    prime = false;
                    break;
                }
            }

            if(prime)
                primeCount++;
        }
    }

    cout << "Number of prime elements = "
         << primeCount << endl;

    return 0;
}
