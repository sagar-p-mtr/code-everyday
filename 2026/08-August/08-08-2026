#include <iostream>
using namespace std;

int main() {
    int n, arr[100], count = 0;

    cout << "Enter number of elements: ";
    cin >> n;

    cout << "Enter elements:\n";
    for(int i = 0; i < n; i++)
        cin >> arr[i];

    for(int i = 0; i < n; i++) {
        bool prime = true;

        if(arr[i] <= 1)
            prime = false;

        for(int j = 2; j * j <= arr[i]; j++) {
            if(arr[i] % j == 0) {
                prime = false;
                break;
            }
        }

        if(prime)
            count++;
    }

    cout << "Number of prime elements = " << count << endl;

    return 0;
}
