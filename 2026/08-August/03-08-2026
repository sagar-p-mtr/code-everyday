#include <iostream>
using namespace std;

int main() {
    int a[3][3];
    int zeroCount = 0;

    cout << "Enter 3x3 matrix:\n";

    for(int i = 0; i < 3; i++) {
        for(int j = 0; j < 3; j++) {
            cin >> a[i][j];

            if(a[i][j] == 0)
                zeroCount++;
        }
    }

    if(zeroCount > (3 * 3) / 2)
        cout << "Sparse Matrix";
    else
        cout << "Not a Sparse Matrix";

    return 0;
}
