#include <iostream>
#include <vector>
using namespace std;

int findMax(vector<int> &a) {
    int mx = a[0];
    for (int x : a)
        mx = max(mx, x);
    return mx;
}

int main() {
    int n;
    cin >> n;

    vector<int> a(n);
    for (int i = 0; i < n; i++)
        cin >> a[i];

    int ans = findMax(a);

    cout << ans << endl;
    return 0;
}
