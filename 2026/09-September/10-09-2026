#include <iostream>
using namespace std;

int main() {
    int arr[100], n;

    cout << "Enter number of elements: ";
    cin >> n;

    cout << "Enter elements:\n";
    for(int i = 0; i < n; i++)
        cin >> arr[i];

    int first = arr[0];
    int second = arr[1];

    if(second > first)
        swap(first, second);

    for(int i = 2; i < n; i++) {
        if(arr[i] > first) {
            second = first;
            first = arr[i];
        }
        else if(arr[i] > second) {
            second = arr[i];
        }
    }

    cout << "Largest sum = " << first + second << endl;

    return 0;
}
