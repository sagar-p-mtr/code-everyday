#include <iostream>
using namespace std;

int main() {
    int a[10], n;
    int min, max;

    cout << "Enter size: ";
    cin >> n;

    cout << "Enter elements: ";
    for (int i = 0; i < n; i++)
        cin >> a[i];

    min = max = a[0];

    for (int i = 1; i < n; i++) {
        if (a[i] < min)
            min = a[i];

        if (a[i] > max)
            max = a[i];
    }

    cout << "Largest difference: " << max - min;

    return 0;
}
