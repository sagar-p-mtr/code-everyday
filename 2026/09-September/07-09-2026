#include <iostream>
using namespace std;

int main() {
    int arr[100], n;
    int smallest, second;

    cout << "Enter number of elements: ";
    cin >> n;

    cout << "Enter elements:\n";
    for(int i = 0; i < n; i++)
        cin >> arr[i];

    smallest = second = 2147483647;

    for(int i = 0; i < n; i++) {
        if(arr[i] < smallest) {
            second = smallest;
            smallest = arr[i];
        }
        else if(arr[i] < second && arr[i] != smallest) {
            second = arr[i];
        }
    }

    cout << "Second smallest = " << second;

    return 0;
}
