#include <iostream>
using namespace std;

int main() {
    int a[10], n, sum = 0;

    cout << "Enter size: ";
    cin >> n;

    cout << "Enter elements: ";
    for (int i = 0; i < n; i++)
        cin >> a[i];

    for (int i = 0; i < n; i++) {
        if (a[i] < 2)
            continue;

        bool prime = true;

        for (int j = 2; j * j <= a[i]; j++) {
            if (a[i] % j == 0) {
                prime = false;
                break;
            }
        }

        if (prime)
            sum += a[i];
    }

    cout << "Sum of prime numbers: " << sum;

    return 0;
}
