#include <iostream>
using namespace std;

int main() {
    int a[10], n;

    cout << "Enter size: ";
    cin >> n;

    cout << "Enter elements: ";
    for (int i = 0; i < n; i++)
        cin >> a[i];

    for (int num = 1; num <= n + 1; num++) {
        bool found = false;

        for (int i = 0; i < n; i++) {
            if (a[i] == num) {
                found = true;
                break;
            }
        }

        if (!found) {
            cout << "First missing positive number: " << num;
            break;
        }
    }

    return 0;
}
