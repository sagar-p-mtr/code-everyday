#include <iostream>
using namespace std;

int main() {
    int n, square, temp, divisor = 1;

    cout << "Enter a number: ";
    cin >> n;

    square = n * n;
    temp = n;

    while (temp > 0) {
        divisor *= 10;
        temp /= 10;
    }

    if (square % divisor == n)
        cout << n << " is an Automorphic Number";
    else
        cout << n << " is not an Automorphic Number";

    return 0;
}
