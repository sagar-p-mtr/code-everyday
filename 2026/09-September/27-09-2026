#include <iostream>
using namespace std;

int main() {
    int a[10], n;
    
    cout << "Enter size: ";
    cin >> n;

    cout << "Enter elements: ";
    for (int i = 0; i < n; i++)
        cin >> a[i];

    int smallest = a[0];
    int second = a[1];

    if (second < smallest)
        swap(smallest, second);

    for (int i = 2; i < n; i++) {
        if (a[i] < smallest) {
            second = smallest;
            smallest = a[i];
        }
        else if (a[i] < second && a[i] != smallest) {
            second = a[i];
        }
    }

    cout << "Second smallest element: " << second;

    return 0;
}
