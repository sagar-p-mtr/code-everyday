#include <iostream>
using namespace std;

int main() {
    int n, temp, rev = 0, digit;

    cout << "Enter a number: ";
    cin >> n;

    temp = n;

    while(temp != 0) {
        digit = temp % 10;
        rev = rev * 10 + digit;
        temp /= 10;
    }

    if(rev == n)
        cout << "Palindrome Number";
    else
        cout << "Not a Palindrome Number";

    return 0;
}
