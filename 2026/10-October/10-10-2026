#include <iostream>
#include <string>
using namespace std;

int main() {
    string str;

    cout << "Enter a sentence: ";
    getline(cin, str);

    int start = 0;

    for (int i = 0; i <= str.length(); i++) {
        if (str[i] == ' ' || i == str.length()) {
            for (int j = i - 1; j >= start; j--)
                cout << str[j];

            cout << " ";
            start = i + 1;
        }
    }

    return 0;
}
