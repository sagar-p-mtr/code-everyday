#include <iostream>
#include <string>
using namespace std;

int main() {
    string sentence, word, longest = "";

    cout << "Enter a sentence: ";
    getline(cin, sentence);

    for (int i = 0; i <= sentence.length(); i++) {
        if (sentence[i] == ' ' || i == sentence.length()) {
            if (word.length() > longest.length())
                longest = word;

            word = "";
        } else {
            word += sentence[i];
        }
    }

    cout << "Longest word: " << longest;

    return 0;
}
