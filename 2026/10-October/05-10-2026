#include <iostream>
using namespace std;

int main() {
    int n, digit;
    int even = 0, odd = 0;

    cout << "Enter a number: ";
    cin >> n;

    while (n > 0) {
        digit = n % 10;

        if (digit % 2 == 0)
            even++;
        else
            odd++;

        n = n / 10;
    }

    cout << "Even digits: " << even << endl;
    cout << "Odd digits: " << odd << endl;

    return 0;
}
