#include <iostream>
using namespace std;

int main() {
    int n;
    bool found = false;

    cout << "Enter a number: ";
    cin >> n;

    for (int i = 1; i * i <= n; i++) {
        if (i * i == n) {
            found = true;
            break;
        }
    }

    if (found)
        cout << n << " is a Perfect Square";
    else
        cout << n << " is not a Perfect Square";

    return 0;
}
