#include <iostream>
using namespace std;

int main() {
    int a, b, sum;

    cout << "Enter first number: ";
    cin >> a;

    cout << "Enter second number: ";
    cin >> b;

    sum = a + b;

    cout << "Sum = " << sum << endl;

    if (sum > 0) {
        cout << "The sum is positive." << endl;
    } else if (sum < 0) {
        cout << "The sum is negative." << endl;
    } else {
        cout << "The sum is zero." << endl;
    }

    cout << "Calculation completed." << endl;
    return 0;
}
