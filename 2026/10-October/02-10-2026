#include <iostream>
using namespace std;

int main() {
    int a[10], n;

    cout << "Enter size: ";
    cin >> n;

    cout << "Enter elements: ";
    for (int i = 0; i < n; i++)
        cin >> a[i];

    int largest = a[0];
    int second = a[1];

    if (second > largest)
        swap(largest, second);

    for (int i = 2; i < n; i++) {
        if (a[i] > largest) {
            second = largest;
            largest = a[i];
        }
        else if (a[i] > second) {
            second = a[i];
        }
    }

    cout << "Largest sum of two elements: "
         << largest + second;

    return 0;
}
