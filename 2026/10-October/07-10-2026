#include <iostream>
using namespace std;

int main() {
    int a[10], n, total = 0, left = 0;

    cout << "Enter size: ";
    cin >> n;

    cout << "Enter elements: ";
    for (int i = 0; i < n; i++) {
        cin >> a[i];
        total += a[i];
    }

    for (int i = 0; i < n; i++) {
        total -= a[i];

        if (left == total) {
            cout << "Equilibrium index: " << i;
            return 0;
        }

        left += a[i];
    }

    cout << "No equilibrium index found";

    return 0;
}
