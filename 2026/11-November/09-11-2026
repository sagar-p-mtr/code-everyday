#include <iostream>
using namespace std;

int main() {
    int units;
    float bill;

    cout << "Electricity Bill Calculator" << endl;
    cout << "Enter electricity units: ";
    cin >> units;

    if (units <= 100) {
        bill = units * 1.5;
    }
    else if (units <= 200) {
        bill = (100 * 1.5) + (units - 100) * 2.5;
    }
    else if (units <= 300) {
        bill = (100 * 1.5) + (100 * 2.5);
        bill += (units - 200) * 4;
    }
    else {
        bill = (100 * 1.5) + (100 * 2.5);
        bill += 100 * 4;
        bill += (units - 300) * 5;
    }

    cout << "\n----- Electricity Bill -----" << endl;
    cout << "Total Units: " << units << endl;
    cout << "Total Bill: Rs. " << bill << endl;

    if (bill > 1000) {
        cout << "High Electricity Usage" << endl;
    }
    else {
        cout << "Normal Electricity Usage" << endl;
    }

    cout << "Thank you!" << endl;

    return 0;
}
