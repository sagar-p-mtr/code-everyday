#include <iostream>
using namespace std;

int main() {
    int num, sum = 0, digit;

    cout << "Enter a number: ";
    cin >> num;

    int original = num;

    if (num < 0) {
        num = -num;
    }

    while (num > 0) {
        digit = num % 10;
        sum += digit;
        num = num / 10;
    }

    cout << "Original number: " << original << endl;
    cout << "Sum of digits: " << sum << endl;

    if (sum % 2 == 0) {
        cout << "The sum is even." << endl;
    } else {
        cout << "The sum is odd." << endl;
    }

    cout << "Program completed successfully." << endl;

    return 0;
}