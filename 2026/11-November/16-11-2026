#include <iostream>
using namespace std;

int main() {
    int units;
    double bill;

    cout << "Enter electricity units: ";
    cin >> units;

    if (units < 0) {
        cout << "Invalid input";
    }
    else if (units <= 100) {
        bill = units * 1.5;
        cout << "Bill: Rs. " << bill;
    }
    else if (units <= 200) {
        bill = 150 + (units - 100) * 2;
        cout << "Bill: Rs. " << bill;
    }
    else {
        bill = 350 + (units - 200) * 3;
        cout << "Bill: Rs. " << bill;
    }

    return 0;
}
