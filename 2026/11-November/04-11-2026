#include <iostream>
using namespace std;

int main() {
    int units;
    double bill;

    cout << "Enter electricity units: ";
    cin >> units;

    if (units < 0) {
        cout << "Invalid units";
        return 0;
    }

    if (units <= 100)
        bill = units * 1.5;
    else if (units <= 200)
        bill = 150 + (units - 100) * 2.5;
    else if (units <= 300)
        bill = 400 + (units - 200) * 4;
    else
        bill = 800 + (units - 300) * 5;

    cout << "Electricity Bill: Rs. " << bill;

    return 0;
}
