#include <iostream>
using namespace std;

int main() {
    int units;
    double bill;

    cout << "Enter electricity units: ";
    cin >> units;

    if (units < 0) {
        cout << "Invalid units entered";
        return 0;
    }

    if (units <= 100) {
        bill = units * 1.5;
    }
    else if (units <= 200) {
        bill = 100 * 1.5 + (units - 100) * 2.5;
    }
    else if (units <= 300) {
        bill = 100 * 1.5 + 100 * 2.5;
        bill += (units - 200) * 4;
    }
    else {
        bill = 100 * 1.5 + 100 * 2.5;
        bill += 100 * 4;
        bill += (units - 300) * 5;
    }

    cout << "\nElectricity Bill Details";
    cout << "\n-----------------------";
    cout << "\nUnits Consumed: " << units;
    cout << "\nTotal Bill: Rs. " << bill;

    if (bill > 1000) {
        cout << "\nHigh Electricity Usage!";
    }
    else {
        cout << "\nNormal Electricity Usage.";
    }

    cout << "\nThank you!";
    return 0;
}