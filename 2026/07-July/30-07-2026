#include <iostream>
using namespace std;

int main() {
    int a[3][3];
    bool scalar = true;

    cout << "Enter 3x3 matrix:\n";

    for(int i = 0; i < 3; i++) {
        for(int j = 0; j < 3; j++) {
            cin >> a[i][j];
        }
    }

    int diagonal = a[0][0];

    for(int i = 0; i < 3; i++) {
        for(int j = 0; j < 3; j++) {
            if(i == j && a[i][j] != diagonal)
                scalar = false;
            if(i != j && a[i][j] != 0)
                scalar = false;
        }
    }

    if(scalar)
        cout << "Scalar Matrix";
    else
        cout << "Not a Scalar Matrix";

    return 0;
}
