#include <iostream>
using namespace std;

int main() {
    int a[3][3];
    bool found = false;

    cout << "Enter 3x3 matrix:\n";

    for(int i = 0; i < 3; i++) {
        for(int j = 0; j < 3; j++) {
            cin >> a[i][j];
        }
    }

    for(int i = 0; i < 3; i++) {
        int minCol = 0;

        for(int j = 1; j < 3; j++) {
            if(a[i][j] < a[i][minCol])
                minCol = j;
        }

        bool saddle = true;

        for(int k = 0; k < 3; k++) {
            if(a[k][minCol] > a[i][minCol]) {
                saddle = false;
                break;
            }
        }

        if(saddle) {
            cout << "Saddle Point = " << a[i][minCol] << endl;
            found = true;
        }
    }

    if(!found)
        cout << "No Saddle Point Found";

    return 0;
}
