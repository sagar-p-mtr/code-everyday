#include <iostream>
using namespace std;

int main() {
    int a[3][3];
    int largest;

    cout << "Enter 3x3 matrix:\n";

    for(int i = 0; i < 3; i++) {
        for(int j = 0; j < 3; j++) {
            cin >> a[i][j];
        }
    }

    largest = a[0][0];

    for(int i = 1; i < 3; i++) {
        if(a[i][i] > largest) {
            largest = a[i][i];
        }
    }

    cout << "Largest diagonal element = "
         << largest << endl;

    return 0;
}
