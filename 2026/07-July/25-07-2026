#include <iostream>
using namespace std;

int main() {
    int a[3][3];

    cout << "Enter 3x3 matrix:\n";

    for(int i = 0; i < 3; i++) {
        for(int j = 0; j < 3; j++) {
            cin >> a[i][j];
        }
    }

    for(int j = 0; j < 3; j++) {
        int min = a[0][j];

        for(int i = 1; i < 3; i++) {
            if(a[i][j] < min) {
                min = a[i][j];
            }
        }

        cout << "Minimum in Column " << j + 1
             << " = " << min << endl;
    }

    return 0;
}
