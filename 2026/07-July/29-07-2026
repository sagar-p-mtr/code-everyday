#include <iostream>
using namespace std;

int main() {
    int a[3][3];
    int smallest;

    cout << "Enter 3x3 matrix:\n";

    for(int i = 0; i < 3; i++) {
        for(int j = 0; j < 3; j++) {
            cin >> a[i][j];
        }
    }

    smallest = a[0][0];

    for(int i = 1; i < 3; i++) {
        if(a[i][i] < smallest) {
            smallest = a[i][i];
        }
    }

    cout << "Smallest diagonal element = "
         << smallest << endl;

    return 0;
}
